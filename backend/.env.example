# Backend env — copy to .env
# API-only mode: no static files, CORS on, listen on all interfaces (Render/Railway need this).
PORT=8000
HOST=0.0.0.0
SERVE_STATIC=0
# Exact frontend origin in prod, e.g. https://swaraj-ai.vercel.app (no trailing slash).
# Leave empty for local dev (allows *).
FRONTEND_URL=
# Optional: Postgres for login/history. Leave unset to run fully offline (auth routes return 503, rest works).
# DATABASE_URL=postgres://sov:sov-local-only@localhost:5432/sovereign
